# Nuitka build directories (root level output)
/build/
/dist/
*.build/
*.dist/
*.onefile-build/

# Do not ignore build scripts inside platform folders
!linux/build/
!macos/build/

# Dynamic build-time config
agent_build_config.py

# Local logs and output inventories
*.log
*.csv

# Local encryption and credentials keys
*.dat

# Python caches
__pycache__/
*.pyc
